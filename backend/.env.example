# JAMT Backend environment configuration
# Copy this file to ".env" for local development, or configure the same
# variables in the Vercel dashboard for production. Never commit a real
# .env file or real credentials.

# ---------------------------------------------------------------------------
# Database (required in production)
# ---------------------------------------------------------------------------
# Local development (optional): defaults to a SQLite file next to the backend,
#   sqlite:///./jamt.db — no configuration needed.
# Production (required): the Neon PostgreSQL *pooled* connection string,
#   including sslmode=require:
# JAMT_DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Note: "postgres://" URLs are automatically normalised to "postgresql://".
# This variable is also honoured by the test suite (defaults to in-memory SQLite there).
JAMT_DATABASE_URL=sqlite:///./jamt.db

# ---------------------------------------------------------------------------
# AI agent -> backend self-calls (required in production)
# ---------------------------------------------------------------------------
# Base URL the AI agent uses to reach this backend's own HTTP API.
# Local development (optional): http://127.0.0.1:8000
# Production (required): your deployed backend URL, no trailing slash:
# BACKEND_API_URL=https://your-backend-project.vercel.app
BACKEND_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# LLM provider (optional — AI Mission Control falls back to deterministic,
# data-grounded answers when no key is configured)
# ---------------------------------------------------------------------------
# Provider-neutral settings. NVIDIA Nemotron 3 Ultra is the configured provider.
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# Backward-compatible OpenRouter settings (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# RAG (optional — deterministic keyword fallback works without these)
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Optional web search (optional)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Official NASA live data integration (optional, enabled by default)
# ---------------------------------------------------------------------------
# No API keys are required for NTRS and PDS — they are public services.
NASA_DATA_ENABLED=true
# Cache lifetime in seconds for NASA responses (default 24h)
NASA_DATA_CACHE_TTL=86400
# Directory where NASA responses are cached (created automatically).
# Local development: ./cache/nasa (default)
# Vercel production: /tmp/jamt-nasa-cache — the filesystem is read-only outside
# /tmp on Vercel; this is also the automatic default when VERCEL is detected.
NASA_CACHE_DIRECTORY=./cache/nasa
# Base URLs — only change to override the public endpoints
NASA_NTRS_API_BASE_URL=https://ntrs.nasa.gov/api
NASA_PDS_API_BASE_URL=https://pds.nasa.gov/api/search/1
# Reserved for future NASA APIs that require a key (optional, unused today)
NASA_API_KEY=

# ---------------------------------------------------------------------------
# Test-only variable (optional — used by the automated test suite)
# ---------------------------------------------------------------------------
# Set to 1 to skip schema initialisation on import; the test suite sets this
# automatically so the local jamt.db is never written to by tests.
# JAMT_SKIP_DB_INIT=1
