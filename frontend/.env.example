# JAMT Frontend environment configuration
# Copy this file to ".env" (local development) or configure the variable in the
# Vercel dashboard (production). Never commit a real .env file.

# Base URL of the deployed (or local) FastAPI backend.
# Required in production. Optional locally — the app falls back to
# http://127.0.0.1:8000 when this variable is not set.
# Local backend (default):
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production example (replace with your Vercel backend URL, no trailing slash):
# VITE_API_BASE_URL=https://your-backend-project.vercel.app
